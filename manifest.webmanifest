{
  "name": "Listo Team – zadania zespołu",
  "short_name": "Listo Team",
  "description": "Zadania, wydarzenia i kalendarz zespołu – synchronizacja na żywo",
  "lang": "pl",
  "start_url": "./#home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#1e1e1e",
  "theme_color": "#1e1e1e",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Dziś", "url": "./#today" },
    { "name": "Moje zadania", "url": "./#mine" }, { "name": "Kalendarz", "url": "./#calendar" }
  ]
}
