{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Listo Team",
  "version": "1.0.0",
  "identifier": "app.listoteam.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Listo Team",
        "url": "https://dasiek07.github.io/listo-team/",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 520,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Listo Team – zadania zespołu",
    "longDescription": "Listo Team – zadania, wydarzenia i kalendarz zespołu z synchronizacją na żywo.",
    "publisher": "Listo Team",
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
